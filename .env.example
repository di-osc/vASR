# Loaded from the current working directory before `vasr-transcribe` parses any subcommand.
# Priority: CLI options > existing process environment > this file > built-in defaults.
# Copy to `.env` and uncomment only what you need; commented entries keep the
# hardware-adaptive default.

# ---------------------------------------------------------------------------
# Model and device
# ---------------------------------------------------------------------------

# Automatic hardware selection is the default.
VASR_DEVICE=auto
VASR_VAD_DEVICE=auto

# Qwen3-ASR model. `Qwen3-ASR-0.6B` / `Qwen3-ASR-1.7B` map to their repo ids; a repo
# id or a local directory also works. Default: Qwen/Qwen3-ASR-0.6B
# VASR_MODEL=Qwen/Qwen3-ASR-0.6B

# In-situ quantization, for example 8 or q8_0. Unset disables quantization.
# VASR_ISQ=8

# ---------------------------------------------------------------------------
# Serve capacity
# ---------------------------------------------------------------------------

# Maximum concurrent decode sequences. Also sizes the KV cache and the CUDA decode
# graph. Unset lets the service estimate a safe value from device and free memory
# (observed: 512 on M4 Pro 48 GB).
# VASR_MAX_NUM_SEQS=64

# Fraction of total GPU memory for weights plus KV. Lower values leave more room for
# audio encoder workspaces. Unset uses the device-adaptive value (observed: 0.8).
# VASR_GPU_MEMORY_UTILIZATION=0.8

# Maximum hotword/context tokens reserved in every ASR KV-cache sequence. Default: 128
# VASR_MAX_HOTWORD_TOKENS=128

# Maximum combined audio duration sent to one ASR audio-encoder batch.
# Unset uses the hardware-adaptive value (observed: 120.0).
# VASR_ASR_ENCODER_BATCH_MAX_AUDIO_SECONDS=30

# Internal serve tuning. These environment variables are retained without public CLI flags.

# Fraction of decode sequences expected to grow from base segment length to max segment
# length. Default: 0.25
# VASR_KV_PEAK_RATIO=0.25

# Maximum VAD segments sent to one ASR audio-encoder batch. Metal auto default is 8
# (the `run` subcommand default is 32). Raise it only for encoder precision scanning,
# for example 4/8/16/32.
# VASR_ASR_ENCODER_BATCH_MAX_SEGMENTS=8

# Service pipeline performance table window in seconds. Default: 5
# VASR_PROFILE_WINDOW=5

# CPU threads used inside VAD model kernels. 0 uses all available Rayon workers. Default: 0
# VASR_VAD_NUM_THREADS=0

# ---------------------------------------------------------------------------
# Execution policy (Metal)
# ---------------------------------------------------------------------------
# `serve` resolves one execution policy at startup and logs the result, for example:
#   serve 执行策略 | device=metal capacity=512 active_slots=32 decode_rows=32 mixed_step=true prefill_wave=8
# The defaults below are tuned for throughput; override them only for capacity or
# precision experiments. Every value is clamped to the resolved safe capacity.

# Concurrent decode slots. Metal auto default: 32. Does not need to equal VASR_MAX_NUM_SEQS.
# VASR_METAL_MAX_ACTIVE_SEQS=32

# Rows per decode forward. `1` reproduces single-sequence numerics at roughly baseline
# throughput; larger values batch different decode steps together for about 2x. Metal auto
# default: equals the active slot count.
# VASR_METAL_PAGED_DECODE_BATCH_SIZE=32

# Maximum sequences packed into one prefill wave. Metal auto default: 8
# VASR_PREFILL_MAX_WAVE=8

# Set to 1 to stop merging different decode steps into one forward.
# VASR_DISABLE_MIXED_STEP_DECODE=1

# ---------------------------------------------------------------------------
# VAD
# ---------------------------------------------------------------------------

# VAD model: firered or fsmn. Default: fsmn
# VASR_VAD_MODEL=fsmn

# VAD speech probability threshold in (0, 1]. Default: 0.6
# VASR_VAD_THRESHOLD=0.6

# Minimum speech duration in milliseconds before a segment is confirmed; must be > 0. Default: 250
# VASR_VAD_MIN_SPEECH_MS=250

# Minimum trailing silence in milliseconds before ending a speech segment; must be > 0. Default: 800
# VASR_VAD_MIN_SILENCE_MS=800

# Symmetric padding in milliseconds added to detected speech segments before ASR;
# 0 disables padding. Default: 0
# VASR_VAD_PAD_MS=0

# Maximum offline VAD segment duration in seconds before ASR; must be finite and > 0. Default: 30
# VASR_VAD_MAX_SEGMENT_SEC=30

# ---------------------------------------------------------------------------
# Workers, endpoint, and language
# ---------------------------------------------------------------------------

# Serve worker defaults are 2. Set 0 to use all available CPU cores.
VASR_NUM_LOAD_WORKERS=2
VASR_NUM_VAD_WORKERS=2

# Enable the periodic service pipeline performance table. Default: false
# VASR_PROFILE=true

# ASR language hint. Default: Chinese
# VASR_LANGUAGE=Chinese

# Bind host. Default: 0.0.0.0
# VASR_HOST=0.0.0.0

# Bind port. Default: 8867
# VASR_PORT=8867

# ---------------------------------------------------------------------------
# Advanced scheduling and backend knobs
# ---------------------------------------------------------------------------
# No CLI flags, and the defaults are right for normal use. Uncomment only when
# investigating a specific problem; some also disable an optimization.

# VASR_LOG=warn,vasr_transcribe=info,vasr::execution=info   # tracing filter
# VASR_ASR_PREFILL_COALESCE_WAIT_MS=20                      # prefill coalescing window
# VASR_ASYNC_PREFILL_CHANNEL_CAP=                           # async prefill channel capacity
# VASR_LOADED_QUEUE_MEMORY_MB=                              # cap queued audio memory in MiB
# VASR_LOADED_QUEUE_MEMORY_FRACTION=                        # or as a fraction of total memory
# VASR_DISABLE_CONTINUOUS_BATCH=1                           # fall back to non-continuous batching
# VASR_DISABLE_LENGTH_SCHEDULE=1                            # disable length-aware scheduling
# VASR_FEATURE_PADDING_MODE=feature                         # feature | waveform | waveform-full
# VASR_QWEN3_ASR_AUDIO_SEQ_BUCKET=0                         # disable audio sequence bucketing
# VASR_QWEN3_ASR_AUDIO_FLASH_ATTN=0                         # force audio attention off flash
# VASR_TIMING_SYNC_BEFORE_ARGMAX=1                          # synchronize before argmax (timing only)

# Attention backend switches.
# VASR_DISABLE_PAGED_ATTN=1                                 # disable paged attention
# VASR_FORCE_PAGED_ATTN=1                                   # force paged attention
# VASR_DISABLE_PACKED_VARLEN=1                              # disable packed varlen attention
# VASR_DISABLE_METAL_VARLEN_PREFILL=1                       # disable Metal varlen prefill
# VASR_ENABLE_METAL_DENSE_VARLEN_PREFILL=1
# VASR_ENABLE_METAL_PAGED_PREFILL_HYBRID=1
# VASR_DISABLE_METAL_PAGED_PREFILL_HYBRID=1
# VASR_ENABLE_METAL_PAGED_VARLEN_PREFILL=1
# VASR_DISABLE_METAL_ISQ=1                                  # disable Metal in-situ quantization
# VASR_Q8_DISABLE_FUSED_QKV=1

# CUDA-only graph and memory knobs.
# VASR_DISABLE_CUDA_GRAPH=1
# VASR_CUDA_GRAPH_MAX_BATCH=
# VASR_CUDA_GRAPH_CONTEXT_TOKENS=
# VASR_CUDA_GRAPH_MIN_BUCKET=
# VASR_CUDA_GRAPH_SINGLE_BUCKET=1
# VASR_CUDA_GRAPH_NEXT_IDS=1
# VASR_CUDA_GRAPH_LOGITS=1
# VASR_CUDA_GRAPH_CHUNKED_ARGMAX=1
# VASR_CUDA_GRAPH_CHUNKED_ARGMAX_SIZE=4096
# VASR_CUDA_GRAPH_LAZY_CAPTURE=1
# VASR_CUDA_GRAPH_PREWARM_MAX_ONLY=1
# VASR_DISABLE_CUDA_PACKED_PREFILL=1
# VASR_PAGED_ATTN_V2_WORKSPACE_RESERVE_MIB=64
# VASR_DISABLE_CUDA_MEMPOOL_RELEASE_THRESHOLD=1
# VASR_CUDA_MEMPOOL_RELEASE_THRESHOLD_MIB=

# ---------------------------------------------------------------------------
# Debug diagnostics
# ---------------------------------------------------------------------------
# All default off. Set to any non-empty value to enable; output goes to stderr.

# VASR_DEBUG_RAW_ASR=1                    # raw ASR input/output shapes
# VASR_DEBUG_ASR_BATCH_TIMING=1           # per-batch stage timing
# VASR_DEBUG_LOCK_WAIT=1                  # Metal model execution lock wait
# VASR_DEBUG_QWEN3_ASR_TIMING=1           # model component timing
# VASR_DEBUG_AUDIO_ENCODER_LAYERS=1       # per-layer audio encoder output
# VASR_DEBUG_CONTINUOUS_DECODE_STEPS=1    # continuous decode step trace
# VASR_DEBUG_REQUEST_MEM=1                # per-request memory accounting
# VASR_DEBUG_CUDA_MEM=1                   # CUDA memory snapshots
# VASR_DEBUG_CUDA_MEM_SYNC=1              # synchronize CUDA mem snapshots
# VASR_DEBUG_CUDA_MEM_VERBOSE=1           # verbose CUDA mem snapshots

# ---------------------------------------------------------------------------
# vasr-realtime only
# ---------------------------------------------------------------------------
# `.env` is loaded by `vasr-transcribe`; the realtime binary reads these from the
# process environment directly.
# VASR_MODEL_KIND=
# VASR_SENSEVOICE_CHUNK_SIZE=
# VASR_SENSEVOICE_MAX_HISTORY=
# VASR_SENSEVOICE_TEXTNORM=
# VASR_CUDA_GRAPH_MAX_SEQS=
