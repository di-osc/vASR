# Loaded from the current working directory before vasr-transcribe parses any subcommand.
# Process environment variables take precedence over this file; CLI options take precedence over both.

# Automatic hardware selection is the default.
VASR_DEVICE=auto
VASR_VAD_DEVICE=auto

# Optional serve overrides. Leave commented to use hardware-adaptive values.
# VASR_MAX_NUM_SEQS=64
# VASR_GPU_MEMORY_UTILIZATION=0.8
# VASR_ASR_ENCODER_BATCH_MAX_AUDIO_SECONDS=30

# Serve worker defaults are 2. Set 0 to use all available CPU cores.
VASR_NUM_LOAD_WORKERS=2
VASR_NUM_VAD_WORKERS=2

# Internal serve tuning. These environment variables are retained without public CLI flags.
# VASR_KV_PEAK_RATIO=0.25
# VASR_ASR_ENCODER_BATCH_MAX_SEGMENTS=32
# VASR_PROFILE_WINDOW=5
# VASR_VAD_NUM_THREADS=0

# Other common configuration.
# VASR_MODEL=Qwen/Qwen3-ASR-0.6B
# VASR_MAX_HOTWORD_TOKENS=128
# VASR_LANGUAGE=Chinese
# VASR_HOST=0.0.0.0
# VASR_PORT=8867
